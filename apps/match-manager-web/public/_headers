# Check for the latest app entry point and update metadata on each request.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Vite emits content hashes in the filenames under assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
