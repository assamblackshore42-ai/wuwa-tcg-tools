{
  "name": "wuwatcg-tools",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "overlay:build": "pnpm --filter @wuwatcg/overlay build",
    "overlay:check": "pnpm --filter @wuwatcg/overlay check",
    "overlay:dev": "pnpm --filter @wuwatcg/overlay dev",
    "overlay:e2e": "pnpm --filter @wuwatcg/overlay test:e2e",
    "overlay:rust:check": "cargo clippy --manifest-path apps/overlay/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "overlay:rust:format": "cargo fmt --manifest-path apps/overlay/src-tauri/Cargo.toml --check",
    "overlay:tauri:build": "pnpm --filter @wuwatcg/overlay tauri:build",
    "overlay:tauri:check": "pnpm --filter @wuwatcg/overlay tauri:check",
    "overlay:tauri:dev": "pnpm --filter @wuwatcg/overlay tauri:dev"
  }
}
