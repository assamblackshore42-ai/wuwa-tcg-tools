{
  "name": "wuwatcg-tools",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "match-core:test": "cargo test --manifest-path crates/Cargo.toml --locked",
    "match-core:check": "cargo clippy --manifest-path crates/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "match-core:format": "cargo fmt --manifest-path crates/Cargo.toml --all --check",
    "match-manager:rust:test": "cargo test --manifest-path apps/match-manager/src-tauri/Cargo.toml --lib --locked",
    "match-manager:build": "pnpm --filter @wuwatcg/match-manager build",
    "match-manager:check": "pnpm --filter @wuwatcg/match-manager check",
    "match-manager:dev": "pnpm --filter @wuwatcg/match-manager dev",
    "match-manager:e2e": "pnpm --filter @wuwatcg/match-manager test:e2e",
    "match-manager:rust:check": "cargo clippy --manifest-path apps/match-manager/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "match-manager:rust:format": "cargo fmt --manifest-path apps/match-manager/src-tauri/Cargo.toml --check",
    "match-manager:tauri:build": "pnpm --filter @wuwatcg/match-manager tauri:build",
    "match-manager:tauri:check": "pnpm --filter @wuwatcg/match-manager tauri:check",
    "match-manager:tauri:dev": "pnpm --filter @wuwatcg/match-manager tauri:dev"
  }
}
